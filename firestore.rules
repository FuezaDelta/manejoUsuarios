rules_version = '2';

// Reglas de seguridad de Firestore para la app de Fuerza Delta.
//
// ─────────────────────────────────────────────────────────────────────────────
// IMPORTANTE — estado actual
//
// La app ya tiene inicio de sesión (Authentication con correo/contraseña) y
// la colección `staff` guarda el rol de cada persona (admin / recepcion), con
// el UID de Authentication como id del documento.
//
// Mientras `modoAbierto()` devuelva true, socios, pagos y planes siguen
// abiertos para cualquiera que conozca el projectId (la colección `staff`
// no: esa siempre exige sesión). Es un riesgo real y consciente.
//
// Para cerrarlo, cuando la versión con login esté publicada en GitHub Pages:
//   1. Cambiar `modoAbierto()` a false aquí abajo.
//   2. Desplegar estas reglas (Firebase Console → Firestore → Reglas, o
//      `firebase deploy --only firestore:rules`).
// Desde ese momento solo el personal activo lee y escribe, y solo un
// administrador edita planes o borra socios y pagos.
//
// Mientras tanto, estas reglas ya aportan tres cosas que las anteriores no:
//   · Se valida la forma de cada documento, así que nadie puede inyectar campos
//     inesperados ni textos gigantes en la base.
//   · Los planes se crean, editan y borran desde la app (solo un administrador
//     cuando `modoAbierto()` sea false). Un borrado no toca las membresías ya
//     cobradas: solo deja de ofrecerse para cobros nuevos.
//   · Cualquier colección no declarada queda denegada.
//
// Las actualizaciones se validan por los campos que cambian
// (`diff().affectedKeys()`), no por el documento resultante. Firestore evalúa en
// `request.resource.data` el documento completo tras el cambio, así que una
// comprobación de tipo `hasOnly` sobre él impediría renovarle la membresía a un
// socio antiguo que tuviera cualquier campo que la app ya no escribe.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function modoAbierto() {
      return true;
    }

    function perfil() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function esPersonalActivo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && perfil().activo == true;
    }

    function esAdmin() {
      return esPersonalActivo() && perfil().rol == 'admin';
    }

    function autorizado() {
      return modoAbierto() || esPersonalActivo();
    }

    function soloAdmin() {
      return modoAbierto() || esAdmin();
    }

    function textoOpcional(datos, campo, maxLongitud) {
      return !(campo in datos)
        || datos[campo] == null
        || (datos[campo] is string && datos[campo].size() <= maxLongitud);
    }

    function fechaOpcional(datos, campo) {
      return !(campo in datos) || datos[campo] is timestamp;
    }

    function conContenido(valor, maxLongitud) {
      return valor is string && valor.size() > 0 && valor.size() <= maxLongitud;
    }

    // Al crear se exige exactamente lo que escribe la app: ni un campo más.
    function usuarioNuevoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
              'nombre', 'apellido', 'telefono', 'email', 'fechaRegistro',
              'membresiaActual', 'fechaInicioMembresia', 'fechaFinMembresia'
            ])
        && conContenido(d.nombre, 80)
        && conContenido(d.apellido, 80)
        && conContenido(d.telefono, 20)
        && d.fechaRegistro is timestamp
        && textoOpcional(d, 'email', 120)
        && textoOpcional(d, 'membresiaActual', 60)
        && fechaOpcional(d, 'fechaInicioMembresia')
        && fechaOpcional(d, 'fechaFinMembresia');
    }

    // La app solo modifica la membresía de un usuario, nunca sus datos
    // personales. Restringir los campos que cambian, en lugar del documento
    // resultante, es más estricto y además no depende de lo que ya hubiera
    // guardado en los documentos antiguos.
    function renovacionValida() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly([
              'membresiaActual', 'fechaInicioMembresia', 'fechaFinMembresia'
            ])
        && conContenido(d.membresiaActual, 60)
        && d.fechaInicioMembresia is timestamp
        && d.fechaFinMembresia is timestamp;
    }

    function pagoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
              'usuarioId', 'planId', 'montoPagado', 'metodoPago',
              'fechaPago', 'fechaInicio', 'fechaFin', 'origen', 'creadoEn'
            ])
        && conContenido(d.usuarioId, 60)
        && conContenido(d.planId, 60)
        && d.montoPagado is number
        && d.montoPagado >= 0
        && d.montoPagado <= 100000000
        && textoOpcional(d, 'metodoPago', 40)
        && textoOpcional(d, 'origen', 20)
        && d.fechaPago is timestamp
        && d.fechaInicio is timestamp
        && d.fechaFin is timestamp
        && fechaOpcional(d, 'creadoEn');
    }

    function planValido() {
      let d = request.resource.data;
      return conContenido(d.nombre, 60)
        && d.precio is number
        && d.precio >= 0
        && d.precio <= 100000000
        && d.duracionDias is number
        && d.duracionDias >= 1
        && d.duracionDias <= 3650
        && d.activo is bool;
    }

    function planNuevoValido() {
      return request.resource.data.keys().hasOnly([
              'nombre', 'precio', 'duracionDias', 'activo'
            ])
        && planValido();
    }

    // Los documentos antiguos pueden traer campos como `tipo`. Solo se
    // comprueba lo que cambia, para no rechazar una edición por eso.
    function planActualizacionValida() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'nombre', 'precio', 'duracionDias', 'activo'
            ])
        && planValido();
    }

    match /planes/{planId} {
      allow read: if autorizado();
      allow create: if soloAdmin() && planNuevoValido();
      allow update: if soloAdmin() && planActualizacionValida();
      allow delete: if soloAdmin();
    }

    match /usuarios/{usuarioId} {
      allow read: if autorizado();
      allow create: if autorizado() && usuarioNuevoValido();
      allow update: if autorizado() && renovacionValida();
      allow delete: if soloAdmin();
    }

    // Los pagos son un registro histórico: se crean y, en el borrado en cascada
    // de un usuario, se eliminan. Nunca se modifican.
    match /pagos/{pagoId} {
      allow read: if autorizado();
      allow create: if autorizado() && pagoValido();
      allow update: if false;
      allow delete: if soloAdmin();
    }

    // Cuentas del personal. El id del documento es el UID de Authentication.
    // Nadie puede quitarse a sí mismo el rol ni desactivarse ni borrarse: así
    // la app nunca se queda sin un administrador que pueda entrar.
    function cuentaStaffValida(d) {
      return d.keys().hasOnly(['usuario', 'nombre', 'rol', 'activo', 'creadoEn'])
        && conContenido(d.usuario, 30)
        && conContenido(d.nombre, 80)
        && d.rol in ['admin', 'recepcion']
        && d.activo is bool
        && fechaOpcional(d, 'creadoEn');
    }

    match /staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create: if esAdmin() && cuentaStaffValida(request.resource.data);
      allow update: if esAdmin()
        && cuentaStaffValida(request.resource.data)
        && request.resource.data.usuario == resource.data.usuario
        && (uid != request.auth.uid
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'activo']));
      allow delete: if esAdmin() && uid != request.auth.uid;
    }

    // Cualquier otra colección queda cerrada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
